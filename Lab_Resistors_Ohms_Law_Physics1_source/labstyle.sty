% ---------------------------------------------------------------- seven-segment digits
% Segments live in a unit cell: digit height 1, width 0.52, pitch 0.80.
\tikzset{
  ss/a/.style={insert path={(0.020,1.000) -- (0.075,1.055) -- (0.445,1.055) -- (0.500,1.000) -- (0.445,0.945) -- (0.075,0.945) -- cycle}},
  ss/b/.style={insert path={(0.520,0.520) -- (0.575,0.575) -- (0.575,0.925) -- (0.520,0.980) -- (0.465,0.925) -- (0.465,0.575) -- cycle}},
  ss/c/.style={insert path={(0.520,0.020) -- (0.575,0.075) -- (0.575,0.425) -- (0.520,0.480) -- (0.465,0.425) -- (0.465,0.075) -- cycle}},
  ss/d/.style={insert path={(0.020,0.000) -- (0.075,0.055) -- (0.445,0.055) -- (0.500,0.000) -- (0.445,-0.055) -- (0.075,-0.055) -- cycle}},
  ss/e/.style={insert path={(0.000,0.020) -- (0.055,0.075) -- (0.055,0.425) -- (0.000,0.480) -- (-0.055,0.425) -- (-0.055,0.075) -- cycle}},
  ss/f/.style={insert path={(0.000,0.520) -- (0.055,0.575) -- (0.055,0.925) -- (0.000,0.980) -- (-0.055,0.925) -- (-0.055,0.575) -- cycle}},
  ss/g/.style={insert path={(0.020,0.500) -- (0.075,0.555) -- (0.445,0.555) -- (0.500,0.500) -- (0.445,0.445) -- (0.075,0.445) -- cycle}},
  ss/dp/.style={insert path={(0.600,-0.055) rectangle (0.690,0.035)}},
  ss/digit 0/.style={ss/a,ss/b,ss/c,ss/d,ss/e,ss/f},
  ss/digit 1/.style={ss/b,ss/c},
  ss/digit 2/.style={ss/a,ss/b,ss/g,ss/e,ss/d},
  ss/digit 3/.style={ss/a,ss/b,ss/g,ss/c,ss/d},
  ss/digit 4/.style={ss/f,ss/g,ss/b,ss/c},
  ss/digit 5/.style={ss/a,ss/f,ss/g,ss/c,ss/d},
  ss/digit 6/.style={ss/a,ss/f,ss/g,ss/e,ss/c,ss/d},
  ss/digit 7/.style={ss/a,ss/b,ss/c},
  ss/digit 8/.style={ss/a,ss/b,ss/c,ss/d,ss/e,ss/f,ss/g},
  ss/digit 9/.style={ss/a,ss/b,ss/c,ss/d,ss/f,ss/g},
  ss/digit -/.style={ss/g},
  ss/digit O/.style={ss/a,ss/b,ss/c,ss/d,ss/e,ss/f},
  ss/digit L/.style={ss/d,ss/e,ss/f},
  ss lit/.style={fill=lcdink},
  ss ghost/.style={fill=lcdghost},
}
\ExplSyntaxOn
\int_new:N \l__lab_ss_cell_int
\int_new:N \l__lab_ss_count_int
\str_new:N \l__lab_ss_str
% \SevenSeg{<text>}{<number of cells>}: right-aligned digits, '.' lights the decimal point
\NewDocumentCommand \SevenSeg { m m }
  {
    \str_set:Nx \l__lab_ss_str {#1}
    \int_zero:N \l__lab_ss_count_int
    \str_map_inline:Nn \l__lab_ss_str
      { \str_if_eq:nnF {##1} {.} { \int_incr:N \l__lab_ss_count_int } }
    \int_step_inline:nnn { 0 } { #2 - 1 }
      { \fill [ ss~ghost , shift = { ( ##1 * 0.80 , 0 ) } , ss/digit~8 ] ; }
    \int_set:Nn \l__lab_ss_cell_int { #2 - \l__lab_ss_count_int - 1 }
    \str_map_inline:Nn \l__lab_ss_str
      {
        \str_if_eq:nnTF {##1} {.}
          { \fill [ ss~lit , shift = { ( \int_use:N \l__lab_ss_cell_int * 0.80 , 0 ) } , ss/dp ] ; }
          {
            \int_incr:N \l__lab_ss_cell_int
            \fill [ ss~lit , shift = { ( \int_use:N \l__lab_ss_cell_int * 0.80 , 0 ) } , ss/digit~##1 ] ;
          }
      }
  }
\ExplSyntaxOff

